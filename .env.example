# ==============================================================================
# Sherman International — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or enter these keys into
# Vercel Project Settings -> Environment Variables for production deployments.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CONNECTION STRINGS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local Development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# For Production (Neon PostgreSQL with connection pooling):
# Format: postgresql://[user]:[password]@[pooler-host]/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@ep-sample-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection (Optional, for direct CLI operations):
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-sample.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying HMAC-SHA256 admin session cookies.
# Minimum recommended length: 32+ cryptographically random characters.
ADMIN_JWT_SECRET="generate-a-secure-random-64-char-string-for-production"

# ------------------------------------------------------------------------------
# 3. SITE URL & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Base URL used for password reset recovery links, sitemap.xml, and robots.txt.
# Local: http://localhost:3000
# Production: https://www.sherman-india.com
NEXT_PUBLIC_SITE_URL="https://www.sherman-india.com"

# ------------------------------------------------------------------------------
# 4. EMAIL INTEGRATION (RESEND)
# ------------------------------------------------------------------------------
# Destination email address that receives customer enquiry notifications
ENQUIRY_NOTIFICATION_EMAIL="admin@sherman-india.com"

# Resend API Key for sending emails (enquiry notifications and password resets)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_sample_api_key_xxxxxxxxxxxxxxxxxxxx"

# Verified sender email address in Resend (Must be verified in Resend dashboard)
# Example: "Sherman International <noreply@sherman-india.com>" or "onboarding@resend.dev"
RESEND_FROM_EMAIL="Sherman International <onboarding@resend.dev>"
